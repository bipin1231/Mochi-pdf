# The backend uses whichever keys exist, in this order, with automatic fallback:
# OpenRouter -> Gemini -> Claude. Users never pick a model.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-sonnet-5-5
APP_URL=http://localhost:3000
